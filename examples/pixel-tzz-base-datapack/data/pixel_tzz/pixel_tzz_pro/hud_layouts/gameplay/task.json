{
  "format_version": 1,
  "surface": "dock",
  "audience": {
    "participants": true,
    "exclude_host": true,
    "online_only": true
  },
  "root": "pixel_tzz:gameplay/task_root",
  "compact_root": "pixel_tzz:gameplay/compact_root",
  "summary_root": "pixel_tzz:gameplay/summary_root",
  "degradation_layout": "pixel_tzz:gameplay/minimal",
  "size": {
    "minimum_width": 144,
    "preferred_width": 218,
    "maximum_width": 244,
    "maximum_height": 136,
    "growth": "up"
  },
  "transition": {
    "enter": "rise_fade",
    "change": "crossfade_values",
    "exit": "fade",
    "enter_sound": {
      "event": "minecraft:block.note_block.pling",
      "volume": 0.28,
      "pitch": 1.15
    },
    "change_sound": {
      "event": "minecraft:block.note_block.hat",
      "volume": 0.18,
      "pitch": 1.0
    }
  }
}
