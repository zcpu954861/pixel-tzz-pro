{
  "format_version": 1,
  "api_version": 4,
  "content_version": 4,
  "name": {
    "text": "全员逃走中 · 3C 验收夹具"
  },
  "initial_phase": "pixel_tzz:setup",
  "default_role": "pixel_tzz:runner",
  "default_life_state": "pixel_tzz:alive",
  "readiness": {
    "phase": "pixel_tzz:ready",
    "action": "pixel_tzz:open_player_readiness",
    "disconnect_invalidates": true,
    "host_can_force": false,
    "message_hooks": {
      "complete": {
        "cue": "pixel_tzz:lifecycle/progress_notice",
        "arguments": {
          "message": "『玩家准备』全员就绪"
        }
      }
    }
  },
  "task_timeline": {
    "initial_task": "pixel_tzz:acceptance/warmup",
    "pause_when_host_offline": false,
    "approval_phase": "pixel_tzz:ready",
    "start_phase": "pixel_tzz:warmup",
    "pre_start_requirements": [
      {
        "type": "required_field",
        "audience": {
          "role_tags": [
            "pixel_tzz:hunter"
          ],
          "exclude_host": true,
          "online_only": false
        },
        "field": "pixel_tzz:hunter_spawn"
      }
    ]
  },
  "player_terminal": {
    "default_page": "pixel_tzz:player/home",
    "history_enabled": true,
    "history_source": "tasks"
  },
  "opening_countdown": {
    "definition": "pixel_tzz:opening/pause",
    "required": true
  },
  "message_hooks": {
    "start": {
      "cue": "pixel_tzz:lifecycle/notice",
      "arguments": {
        "message": "『全员逃走中 · 2D 验收夹具』正式开始"
      }
    },
    "pause": {
      "cue": "pixel_tzz:lifecycle/notice",
      "arguments": {
        "message": "『全员逃走中 · 2D 验收夹具』已暂停"
      }
    },
    "resume": {
      "cue": "pixel_tzz:lifecycle/notice",
      "arguments": {
        "message": "『全员逃走中 · 2D 验收夹具』已继续"
      }
    },
    "end": {
      "cue": "pixel_tzz:lifecycle/notice",
      "arguments": {
        "message": "『全员逃走中 · 2D 验收夹具』已结束"
      }
    }
  }
}
