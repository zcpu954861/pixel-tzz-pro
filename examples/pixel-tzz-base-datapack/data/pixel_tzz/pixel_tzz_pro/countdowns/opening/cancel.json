{
  "format_version": 1,
  "name": {
    "text": "正式开局倒计时 · 掉线取消"
  },
  "duration": "10s",
  "display_audience": {
    "include_host": true,
    "include_observers": false
  },
  "presentation": {
    "title": {
      "text": "正式开局",
      "color": "aqua"
    },
    "time": {
      "format": "mm_ss",
      "precision": "seconds",
      "leading_zero": true,
      "separator": ":",
      "color": "#F4F7FA",
      "scale": 1.0,
      "shadow": true
    },
    "progress": {
      "mode": "none",
      "color": "#F2C14EFF",
      "track_color": "#33424E60",
      "thickness": 1,
      "smooth": false
    },
    "digits": {
      "transition": "instant",
      "direction": "down",
      "duration_ms": 0,
      "distance": 8,
      "easing": "linear",
      "stagger_ms": 0,
      "animate_fractional": false,
      "incoming_color": "#FFFFFFFF",
      "outgoing_color": "#8A9AA8FF",
      "incoming_alpha": 1.0,
      "outgoing_alpha": 0.55
    }
  },
  "disconnect": {
    "required_player": "cancel",
    "host": "continue"
  },
  "restrictions": {
    "movement": "freeze",
    "attack": "block",
    "interact": "block",
    "items": {
      "use": "block",
      "drop": "block",
      "swap": "block",
      "inventory": "block"
    },
    "damage": "immune",
    "camera": "allow",
    "chat": "allow",
    "escape": "allow"
  },
  "checkpoints": [
    {
      "id": "five_seconds",
      "remaining": "5s",
      "sound": {
        "event": "minecraft:block.note_block.pling",
        "volume": 0.55,
        "pitch": 0.9
      }
    },
    {
      "id": "three_seconds",
      "remaining": "3s",
      "sound": {
        "event": "minecraft:block.note_block.pling",
        "volume": 0.58,
        "pitch": 1.0
      }
    },
    {
      "id": "two_seconds",
      "remaining": "2s",
      "sound": {
        "event": "minecraft:block.note_block.pling",
        "volume": 0.62,
        "pitch": 1.1
      }
    },
    {
      "id": "one_second",
      "remaining": "1s",
      "sound": {
        "event": "minecraft:block.note_block.pling",
        "volume": 0.68,
        "pitch": 1.2
      }
    },
    {
      "id": "start",
      "remaining": "0t",
      "sound": {
        "event": "minecraft:block.note_block.chime",
        "volume": 0.72,
        "pitch": 1.35
      }
    }
  ],
  "callbacks": {
    "start": [
      {
        "id": "audit_start",
        "scope": "global",
        "function": "pixel_tzz:acceptance_3c/countdown/callback/global",
        "required": true
      }
    ],
    "pause": [
      {
        "id": "audit_pause",
        "scope": "global",
        "function": "pixel_tzz:acceptance_3c/countdown/callback/global",
        "required": true
      }
    ],
    "resume": [
      {
        "id": "audit_resume",
        "scope": "global",
        "function": "pixel_tzz:acceptance_3c/countdown/callback/global",
        "required": true
      }
    ],
    "cancel": [
      {
        "id": "audit_cancel",
        "scope": "global",
        "function": "pixel_tzz:acceptance_3c/countdown/callback/global",
        "required": true
      }
    ],
    "complete": [
      {
        "id": "audit_complete",
        "scope": "global",
        "function": "pixel_tzz:acceptance_3c/countdown/callback/global",
        "required": true
      },
      {
        "id": "fault_gate",
        "scope": "global",
        "function": "pixel_tzz:acceptance_3c/countdown/callback/fault_gate",
        "required": true
      },
      {
        "id": "audit_participant",
        "scope": "each_participant",
        "function": "pixel_tzz:acceptance_3c/countdown/callback/participant",
        "required": true
      }
    ]
  }
}
