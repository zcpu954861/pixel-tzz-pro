{
  "format_version": 1,
  "game": "pixel_tzz:main",
  "title": {
    "text": "事件详情"
  },
  "theme": "pixel_tzz:control_console",
  "root": {
    "type": "column",
    "id": "player_history_detail_page",
    "layout": {
      "width": {
        "mode": "fill"
      },
      "height": {
        "mode": "fill"
      },
      "gap": 10,
      "padding": {
        "vertical": 16,
        "horizontal": 18
      }
    },
    "events": {
      "show": {
        "motion": "panel_enter"
      },
      "hide": {
        "motion": "panel_exit"
      }
    },
    "children": [
      {
        "type": "card",
        "style": "broadcast_panel",
        "layout": {
          "width": {
            "mode": "fill"
          }
        },
        "child": {
          "type": "row",
          "layout": {
            "width": {
              "mode": "fill"
            },
            "gap": 10,
            "padding": {
              "vertical": 9,
              "horizontal": 11
            },
            "cross_align": "center"
          },
          "children": [
            {
              "type": "column",
              "layout": {
                "width": {
                  "mode": "weight",
                  "value": 1
                },
                "gap": 3
              },
              "children": [
                {
                  "type": "text",
                  "style": "runner_eyebrow",
                  "text": {
                    "text": "EVENT DOSSIER / 事件详情"
                  }
                },
                {
                  "type": "text",
                  "style": "runner_title",
                  "text": {
                    "bind": "detail.title",
                    "fallback": {
                      "text": "记录已不可用"
                    }
                  },
                  "wrap": true,
                  "max_lines": 2,
                  "overflow": "ellipsis"
                },
                {
                  "type": "text",
                  "style": "utility_label",
                  "text": {
                    "text": "此页由服务端重新核验事件授权后生成，不接受客户端指定目标页面。"
                  },
                  "wrap": true,
                  "max_lines": 2,
                  "overflow": "ellipsis"
                }
              ]
            },
            {
              "type": "card",
              "style": "status_rail",
              "visible_when": {
                "eq": [
                  {
                    "bind": "detail.detail_available"
                  },
                  {
                    "literal": true
                  }
                ]
              },
              "child": {
                "type": "column",
                "layout": {
                  "gap": 2,
                  "padding": {
                    "vertical": 6,
                    "horizontal": 8
                  }
                },
                "children": [
                  {
                    "type": "text",
                    "style": "utility_label",
                    "text": {
                      "text": "AUTHORIZED"
                    }
                  },
                  {
                    "type": "text",
                    "style": "status_success",
                    "text": {
                      "text": "已核验"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "type": "card",
        "style": "hunter_target",
        "visible_when": {
          "eq": [
            {
              "bind": "detail.exists"
            },
            {
              "literal": false
            }
          ]
        },
        "child": {
          "type": "column",
          "layout": {
            "gap": 4,
            "padding": {
              "vertical": 12,
              "horizontal": 14
            }
          },
          "children": [
            {
              "type": "text",
              "style": "hunter_title",
              "text": {
                "text": "这条记录现在无法查看"
              }
            },
            {
              "type": "text",
              "style": "utility_label",
              "text": {
                "text": "事件可能尚未到公开时机、受众资格已经变化，或记录已被清理。返回列表即可继续浏览。"
              },
              "wrap": true,
              "max_lines": 3,
              "overflow": "ellipsis"
            }
          ]
        }
      },
      {
        "type": "scroll",
        "id": "player_history_detail_scroll",
        "visible_when": {
          "eq": [
            {
              "bind": "detail.exists"
            },
            {
              "literal": true
            }
          ]
        },
        "layout": {
          "width": {
            "mode": "fill"
          },
          "height": {
            "mode": "weight",
            "value": 1
          }
        },
        "direction": "vertical",
        "show_scrollbar": true,
        "child": {
          "type": "column",
          "layout": {
            "width": {
              "mode": "fill"
            },
            "gap": 8,
            "padding": {
              "right": 5
            }
          },
          "children": [
            {
              "type": "card",
              "style": "runner_dossier",
              "child": {
                "type": "column",
                "layout": {
                  "gap": 6,
                  "padding": {
                    "vertical": 10,
                    "horizontal": 12
                  }
                },
                "children": [
                  {
                    "type": "text",
                    "style": "runner_eyebrow",
                    "visible_when": {
                      "exists": {
                        "bind": "detail.category"
                      }
                    },
                    "text": {
                      "bind": "detail.category"
                    }
                  },
                  {
                    "type": "text",
                    "style": "rule_body",
                    "visible_when": {
                      "exists": {
                        "bind": "detail.summary"
                      }
                    },
                    "text": {
                      "bind": "detail.summary"
                    },
                    "wrap": true,
                    "max_lines": 5,
                    "overflow": "ellipsis"
                  },
                  {
                    "type": "divider",
                    "style": "runner_divider",
                    "direction": "horizontal",
                    "thickness": 1
                  },
                  {
                    "type": "text",
                    "style": "status_identity",
                    "visible_when": {
                      "exists": {
                        "bind": "detail.details"
                      }
                    },
                    "text": {
                      "bind": "detail.details"
                    },
                    "wrap": true,
                    "max_lines": 10,
                    "overflow": "ellipsis"
                  }
                ]
              }
            },
            {
              "type": "grid",
              "layout": {
                "width": {
                  "mode": "fill"
                },
                "columns": [
                  {
                    "mode": "weight",
                    "value": 1
                  },
                  {
                    "mode": "weight",
                    "value": 1
                  },
                  {
                    "mode": "weight",
                    "value": 1
                  }
                ],
                "column_gap": 8,
                "row_gap": 8
              },
              "responsive": {
                "compact": {
                  "layout": {
                    "columns": [
                      {
                        "mode": "weight",
                        "value": 1
                      }
                    ]
                  }
                }
              },
              "children": [
                {
                  "type": "card",
                  "style": "status_rail",
                  "visible_when": {
                    "exists": {
                      "bind": "detail.task_name"
                    }
                  },
                  "child": {
                    "type": "column",
                    "layout": {
                      "gap": 3,
                      "padding": {
                        "vertical": 8,
                        "horizontal": 10
                      }
                    },
                    "children": [
                      {
                        "type": "text",
                        "style": "utility_label",
                        "text": {
                          "text": "TASK / 所属任务"
                        }
                      },
                      {
                        "type": "text",
                        "style": "status_identity",
                        "text": {
                          "bind": "detail.task_name"
                        },
                        "wrap": true,
                        "max_lines": 2,
                        "overflow": "ellipsis"
                      }
                    ]
                  }
                },
                {
                  "type": "card",
                  "style": "status_rail",
                  "visible_when": {
                    "exists": {
                      "bind": "detail.game_time"
                    }
                  },
                  "child": {
                    "type": "column",
                    "layout": {
                      "gap": 3,
                      "padding": {
                        "vertical": 8,
                        "horizontal": 10
                      }
                    },
                    "children": [
                      {
                        "type": "text",
                        "style": "utility_label",
                        "text": {
                          "text": "GAME TIME / 发生时间"
                        }
                      },
                      {
                        "type": "text",
                        "style": "progress_value",
                        "text": {
                          "bind": "detail.game_time_text",
                          "fallback": {
                            "text": "时间未公开"
                          }
                        }
                      }
                    ]
                  }
                },
                {
                  "type": "card",
                  "style": "status_rail",
                  "visible_when": {
                    "exists": {
                      "bind": "detail.actor.uuid"
                    }
                  },
                  "child": {
                    "type": "row",
                    "layout": {
                      "gap": 7,
                      "padding": {
                        "vertical": 8,
                        "horizontal": 10
                      },
                      "cross_align": "center"
                    },
                    "children": [
                      {
                        "type": "player_head",
                        "uuid": {
                          "bind": "detail.actor.uuid"
                        },
                        "name": {
                          "bind": "detail.actor.name"
                        },
                        "online": {
                          "literal": true
                        },
                        "show_status": false,
                        "layout": {
                          "width": {
                            "mode": "fixed",
                            "value": 24
                          },
                          "height": {
                            "mode": "fixed",
                            "value": 24
                          }
                        }
                      },
                      {
                        "type": "column",
                        "layout": {
                          "gap": 2
                        },
                        "children": [
                          {
                            "type": "text",
                            "style": "utility_label",
                            "text": {
                              "text": "ACTOR / 触发者"
                            }
                          },
                          {
                            "type": "text",
                            "style": "status_identity",
                            "text": {
                              "bind": "detail.actor.name"
                            },
                            "max_lines": 1,
                            "overflow": "ellipsis"
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "type": "row",
        "layout": {
          "width": {
            "mode": "fill"
          },
          "gap": 8,
          "cross_align": "center"
        },
        "children": [
          {
            "type": "button",
            "id": "history_detail_back",
            "style": "navigation_button",
            "layout": {
              "width": {
                "mode": "fixed",
                "value": 150
              }
            },
            "label": {
              "text": "返回过去事件"
            },
            "action": {
              "type": "local",
              "name": "back"
            },
            "events": {
              "press": {
                "motion": "button_press",
                "sound": "button_press"
              }
            }
          },
          {
            "type": "text",
            "style": "utility_label",
            "layout": {
              "width": {
                "mode": "weight",
                "value": 1
              }
            },
            "text": {
              "text": "DETAIL VIEW / 仅展示当前仍获授权的公开字段"
            },
            "text_align": "right"
          }
        ]
      }
    ]
  }
}
