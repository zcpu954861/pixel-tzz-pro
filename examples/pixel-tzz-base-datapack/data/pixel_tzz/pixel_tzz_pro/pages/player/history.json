                        "item_key": {
                          "bind": "item.id"
                        },
                        "max_items": 72,
                        "estimated_item_height": 24,
                        "template": {
                          "type": "row",
                          "layout": {
                            "width": {
                              "mode": "fill"
                            },
                            "gap": 8,
                            "padding": {
                              "vertical": 4,
                              "horizontal": 2
                            },
                            "cross_align": "start"
                          },
                          "children": [
                            {
                              "type": "text",
                              "style": "utility_label",
                              "layout": {
                                "width": {
                                  "mode": "fixed",
                                  "value": 76
                                }
                              },
                              "text": {
                                "bind": "item.label"
                              },
                              "wrap": true,
                              "max_lines": 2,
                              "overflow": "ellipsis"
                            },
                            {
                              "type": "divider",
                              "style": "ui_divider_cyan",
                              "direction": "vertical",
                              "thickness": 1,
                              "layout": {
                                "height": {
                                  "mode": "fixed",
                                  "value": 15
                                }
                              }
                            },
                            {
                              "type": "text",
                              "style": "rule_body",
                              "layout": {
                                "width": {
                                  "mode": "weight",
                                  "value": 1
                                }
                              },
                              "text": {
                                "bind": "item.value"
                              },
                              "wrap": true,
                              "overflow": "ellipsis"
                            }
                          ]
                        }
                      },
                      {
                        "type": "card",
                        "style": "ui_detail_body",
                        "visible_when": {
                          "exists": {
                            "bind": "detail.details"
                          }
                        },
                        "child": {
                          "type": "column",
                          "layout": {
                            "gap": 5,
                            "padding": {
                              "vertical": 9,
                              "horizontal": 10
                            }
                          },
                          "children": [
                            {
                              "type": "text",
                              "style": "ui_kicker_success",
                              "text": {
                                "text": "回顾内容"
                              }
                            },
                            {
                              "type": "text",
                              "style": "rule_body",
                              "text": {
                                "bind": "detail.details"
                              },
                              "wrap": true
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
