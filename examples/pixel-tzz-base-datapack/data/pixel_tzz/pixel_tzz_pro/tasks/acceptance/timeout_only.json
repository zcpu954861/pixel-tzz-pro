{
  "format_version": 1,
  "game": "pixel_tzz:main",
  "version": 1,
  "kind": "main",
  "name": {
    "text": "2D 验收 · 仅超时任务"
  },
  "description": {
    "text": "10 秒、只能等待倒计时结束的验收任务，不提供提前完成入口。"
  },
  "audience": {
    "role_tags": [
      "pixel_tzz:active_participant"
    ],
    "exclude_host": true,
    "online_only": false
  },
  "completion_policy": "timeout_only",
  "duration_ticks": 200,
  "counts_toward_game_time": true,
  "live_visibility": {
    "future": "teaser",
    "history": "hidden",
    "candidate_visibility": "none"
  },
  "recap_visibility": "participants",
  "message_hooks": {
    "start": {
      "cue": "pixel_tzz:lifecycle/notice",
      "arguments": {
        "message": "任务「2D 验收 · 仅超时任务」开始"
      }
    },
    "complete": {
      "cue": "pixel_tzz:lifecycle/notice",
      "arguments": {
        "message": "任务「2D 验收 · 仅超时任务」完成"
      }
    },
    "interrupt": {
      "cue": "pixel_tzz:lifecycle/notice",
      "arguments": {
        "message": "任务「2D 验收 · 仅超时任务」已中断"
      }
    }
  },
  "callbacks": {
    "on_start": "pixel_tzz:acceptance_2d/timeline/capture_context",
    "on_timeout": "pixel_tzz:acceptance_2d/timeline/timeout_final_task",
    "on_settled": "pixel_tzz:acceptance_2d/timeline/capture_result"
  },
  "results": [
    {
      "id": "finished",
      "name": {
        "text": "仅超时任务完成"
      },
      "semantic": "success",
      "recap": {
        "text": "任务到时后由任务超时回调提交唯一合法结果。"
      },
      "on_apply": "pixel_tzz:acceptance_2d/timeline/capture_result",
      "route": {
        "end_phase": "pixel_tzz:ended",
        "intermission": {
          "duration_ticks": 1200,
          "counts_toward_game_time": false,
          "name": {
            "text": "最终回顾准备 · 60 秒确认间隔"
          },
          "on_start": "pixel_tzz:acceptance_2d/timeline/capture_result",
          "on_complete": "pixel_tzz:acceptance_2d/timeline/capture_result"
        }
      }
    }
  ],
  "events": [
    {
      "id": "deadline_reached",
      "name": {
        "text": "仅超时任务到达时限"
      },
      "message_hooks": {
        "trigger": {
          "cue": "pixel_tzz:lifecycle/notice",
          "arguments": {
            "message": "事件「仅超时任务到达时限」已记录"
          }
        }
      },
      "policy": "once",
      "allowed_states": [
        "settling"
      ],
      "recap_visibility": "participants",
      "player_history": {
        "release": "task_end",
        "audience": {
          "role_tags": [
            "pixel_tzz:active_participant"
          ],
          "exclude_host": true,
          "online_only": false
        },
        "title": {
          "text": "仅超时任务完成"
        },
        "detail_page": "pixel_tzz:player/history",
        "summary": {
          "text": "倒计时自然结束，唯一合法结果已经提交。"
        },
        "color": "#65D68A",
        "category": "task_result",
        "show_game_time": true,
        "show_task": true,
        "show_actor": false,
        "show_targets": false,
        "show_personal_result": true,
        "details": {
          "text": "本记录用于验收任务结束后公开、稳定回顾和终局重连恢复。"
        }
      }
    }
  ],
  "statistics": []
}
