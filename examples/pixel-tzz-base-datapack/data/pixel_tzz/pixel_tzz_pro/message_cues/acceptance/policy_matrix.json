        "max_graphemes": 32,
        "estimated_width": 192,
        "max_lines": 1
      }
    },
    "task_ref": {
      "source": {
        "argument": "task_id"
      },
      "reservation": {
        "max_graphemes": 64
      }
    },
    "history_target_name": {
      "source": {
        "argument": "history_target"
