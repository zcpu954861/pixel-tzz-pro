{
  "format_version": 1,
  "game": "pixel_tzz:main",
  "required": true,
  "policies": {
    "timing": {
      "clock": "game_time",
      "synchronization": "synchronized",
      "synchronized_wait": "5t",
      "late_arrival": "seek",
      "synchronization_timeout": "start_available"
    },
    "audience": {
      "target": {
        "any_of": [
          {
            "source": "current_host",
            "online_only": true
          },
          {
            "source": "call_targets",
            "roles": [
              "pixel_tzz:hunter"
            ],
            "exclude_host": true,
            "online_only": true
          }
        ]
      },
      "evolution": "live_strict",
      "sensitive": true,
      "on_loss": "cancel"
    },
    "context": {
      "games": [
        "pixel_tzz:main"
      ],
      "phases": [
        "pixel_tzz:running"
      ],
      "tasks": [
        "pixel_tzz:acceptance/main_branch"
      ],
      "recheck": "live_strict"
    },
    "concurrency": {
      "duplicate": "refresh",
      "cooldown": "1s",
      "dedupe_targets": true,
      "dedupe_parameters": [
        "target",
        "task_id"
      ],
      "refresh_key": "target",
      "chat_interrupt": "remove",
      "priority": 12,
      "groups": [
        "acceptance",
        "task_notice"
      ]
    },
    "delivery": {
      "empty_audience": "callbacks_only",
      "offline_targets": "queue",
      "offline_ttl": "30s"
    },
    "lifecycle": {
      "screen_start": {
        "chat": "immediate",
        "title": "close_safe_screen",
        "subtitle": "wait_gameplay",
        "action_bar": "final_chat_only"
      },
      "obscured": {
        "chat": "continue",
        "title": "pause",
        "subtitle": "finalize",
        "action_bar": "cancel"
      },
      "screen_wait_timeout": "5s",
      "screen_timeout_action": "final_chat_only",
      "max_pause": "4s",
      "reload": "finalize",
      "restart": "continue",
      "external_conflict": "overlay",
      "reconnect": "restart",
      "late_join": "from_start",
      "resource_reload": "finalize",
      "respawn": "finalize",
      "attachment": "world",
      "dimension_exit": "cancel"
    },
    "accessibility": {
      "allow_manual_complete": true,
      "reduced_motion": "static_final"
    },
    "control_groups": [
      "acceptance",
      "host_notice"
    ],
    "capture": "per_field",
    "default_conflict": "queue"
  },
  "parameters": {
    "target": {
      "type": "player",
      "required": true,
      "sources": [
        "call_argument",
        "invoker",
        "origin",
        "target"
