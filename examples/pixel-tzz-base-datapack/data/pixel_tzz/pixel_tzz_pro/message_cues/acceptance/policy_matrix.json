      "dedupe": true,
      "allowed_nodes": [
        "intro",
        "follow_sound"
      ],
      "audience": {
        "source": "call_targets",
        "online_only": true
      },
      "sensitive": true
    },
    "task_id": {
      "type": "identifier",
      "default": "pixel_tzz:acceptance/main_branch",
      "sources": [
        {
          "type": "game_context",
          "value": "task"
        },
        {
          "type": "storage",
          "storage": "pixel_tzz:acceptance_3b",
          "path": "task.id"
        }
      ],
      "on_error": "use_default",
      "dedupe": true,
      "allowed_nodes": [
        "intro"
      ],
      "identifier_kind": "task"
    },
    "history_target": {
      "type": "player",
      "required": true,
      "sources": [
        "call_argument",
        "target",
        "invoker",
        "origin"
      ],
      "on_error": "fail",
      "audience": {
        "source": "call_targets",
        "online_only": true
      },
      "sensitive": true
    },
    "history_task_id": {
      "type": "identifier",
      "default": "pixel_tzz:acceptance/main_branch",
      "sources": [
        {
          "type": "game_context",
          "value": "task"
        },
        {
          "type": "storage",
          "storage": "pixel_tzz:acceptance_3b",
          "path": "task.id"
        }
      ],
      "on_error": "use_default",
      "identifier_kind": "task"
    },
    "score_value": {
      "type": "integer",
      "default": 0,
      "sources": [
        {
          "type": "score",
          "objective": "pixel_tzz_demo",
          "holder": "@s"
        }
      ],
      "on_error": "use_default",
      "allowed_nodes": [
        "intro"
      ]
    },
    "profile_value": {
      "type": "string",
      "sources": [
        {
          "type": "player_data",
          "field": "pixel_tzz:current_task_name"
        }
      ],
      "on_error": {
        "mode": "use_fallback",
        "fallback": "未知任务"
      },
      "allowed_nodes": [
        "intro"
      ]
    }
  },
  "fields": {
    "target_name": {
      "capture": "on_first_field",
      "source": {
        "argument": "target"
      },
      "fallback": {
